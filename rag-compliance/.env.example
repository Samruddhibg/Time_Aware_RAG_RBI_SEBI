# =============================================================================
# Time-Aware RAG — RBI/SEBI Compliance Assistant
# Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Connection string for the asyncpg driver (used by the API and all scripts)
DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/ragdb

# Docker Compose uses these to initialise the postgres container
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass          # CHANGE THIS in production
POSTGRES_DB=ragdb
DB_PORT=5432                       # host port mapped to container 5432


# ── Embedding model ───────────────────────────────────────────────────────────
# HuggingFace model ID or local path to a fine-tuned model directory.
#   Before fine-tuning : BAAI/bge-small-en-v1.5  (downloaded automatically)
#   After fine-tuning  : models/bge-small-ft      (local path)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Must match the output dimension of your embedding model
EMBED_DIM=384

# Batch size for encoding passages during ingest (reduce if you hit OOM)
EMBED_BATCH=64


# ── LLM (OpenAI-compatible endpoint) ─────────────────────────────────────────
# Ollama (local, default):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama                 # Ollama ignores this; set a real key for OpenAI

# OpenAI (cloud alternative):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# vLLM (self-hosted, higher throughput):
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# LLM_API_KEY=token-abc123

# Generation settings
LLM_TEMPERATURE=0.0                # 0.0 for deterministic compliance answers
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60                     # seconds before giving up on LLM response


# ── Retrieval ─────────────────────────────────────────────────────────────────
# Dense (HNSW vector search) candidates
TOP_K_DENSE=20

# Lexical (full-text search) candidates
TOP_K_LEXICAL=20

# Final chunks after Reciprocal Rank Fusion
TOP_K_RERANK=6

# Cosine similarity threshold — below this the system refuses to answer
# rather than hallucinate. Increase to be more conservative (more refusals).
MIN_SIM_THRESHOLD=0.35


# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

LOG_LEVEL=info                     # debug | info | warning | error


# ── Docker Compose port overrides ─────────────────────────────────────────────
FRONTEND_PORT=3000                 # Host port for the nginx frontend container
VITE_API_URL=http://localhost:8000 # Frontend → backend URL (used at build time)
